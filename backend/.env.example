# Development bridge only. Copy to .env and fill in actual values.
PORT=3000
FLUTTER_WEB_ORIGIN=http://localhost:8080
# Actual Novu REST API origin (without /v1), not the dashboard UI URL.
# https://api.novu.co is ONLY for Novu Cloud; self-hosted installations
# must use their own API host or reverse-proxy route.
NOVU_API_BASE_URL=https://YOUR_NOVU_API_HOST
NOVU_ENVIRONMENT=Production
NOVU_SECRET_KEY=REPLACE_WITH_NOVU_API_KEY_FOR_THIS_ENVIRONMENT
NOVU_SUBSCRIBER_ID=flutter-test-001
NOVU_WORKFLOW_ID=com-test-flutter
NOVU_FCM_INTEGRATION_IDENTIFIER=
# Long random local secret for manual admin trigger requests.
TEST_TRIGGER_KEY=REPLACE_WITH_LONG_RANDOM_LOCAL_TEST_KEY
# Optional absolute HTTPS click link. Leave blank during first test.
WEB_PUSH_LINK=
